---
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../../layouts/Layout.astro';
import BlogListing from '../../components/BlogListing.astro';
import { getCollection } from 'astro:content';
import { isLive, byDateDesc, toPreview, type PostPreview } from '../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog')).filter(isLive).sort(byDateDesc).map(toPreview);
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<PostPreview>;
}

const { page } = Astro.props;

const allPosts = (await getCollection('blog')).filter(isLive).sort(byDateDesc).map(toPreview);
const allTags = [...new Set(allPosts.flatMap((p) => p.tags))].sort((a, b) => a.localeCompare(b));

const title =
  page.currentPage === 1
    ? 'Blog - Michael Hutchinson'
    : `Blog - Page ${page.currentPage} - Michael Hutchinson`;
---

<Layout
  title={title}
  description="Thoughts on AI-powered engineering, technical leadership, and building great software."
>
  <div class="mx-auto max-w-3xl px-6 py-24 md:py-32">
    <nav class="text-text-muted mb-8 flex items-center gap-1.5 font-mono text-xs">
      <a href="/" class="hover:text-text transition-colors">~</a>
      <span>/</span>
      <span class="text-text-secondary">blog</span>
    </nav>
    <h1 class="sr-only">Blog</h1>
    <div class="mb-2 flex items-baseline gap-2.5 text-[0.9375rem]">
      <span
        class="text-base font-bold select-none"
        style="background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2), var(--color-accent-3)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
        >❯</span
      >
      <span class="text-text">ls ~/blog/</span>
    </div>
    <p class="text-text-muted mb-8 font-mono text-sm">
      # AI-first engineering, technical leadership, and building things that ship
    </p>

    <BlogListing
      pagePosts={page.data}
      allPosts={allPosts}
      allTags={allTags}
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
    />
  </div>
</Layout>
